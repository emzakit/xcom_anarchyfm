# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# --- Virtual environment ---
venv/
.venv/
env/

# --- Personal / machine-specific config (generated on first run) ---
# Contains local paths to your game, music, and log files — and, if you use
# the experimental Spotify feature, your Spotify API credentials.
xipod_config.json

# --- WIP ---
# Contains work in progress docs and tracking of features
wip/
update_test/

# Spotify OAuth token cache — access/refresh tokens for YOUR account.
.spotify_cache.json

# --- User music library + runtime logs ---
# Ship the empty STATE_ folder structure (via .gitkeep) but never the
# audio itself or the per-session logs.
*.mp3
*.wav
*.ogg
*.flac
*.m4a
music/_logs/
*.log

# --- Music pack authoring ---
# Created next to the app on first run. addon_projects/ holds ModBuddy
# solutions, addon_test/ holds built packs being tried out — someone else's
# work in progress, not part of this repo.
addon_test/
addon_projects/

# --- PyInstaller build output ---
build/
dist/

# --- Editor / tool state ---
.claude/
.vscode/
.idea/

# --- OS cruft ---
Thumbs.db
desktop.ini
.DS_Store


